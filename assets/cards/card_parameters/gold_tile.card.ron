ProxyCard (
    name: "Gold tile",
    price: 2,
    action: ProxyAction (
        functionality: ConvertTileTo(PassiveGold),
        eligibility_method: AllTiles,
        selection_count_bounds: GameDesignBounds(Bounds(min_tiles: 1, max_tiles: 2)),
        ),
    image_path: "cards/card_images/GoldTile.png",
    rarity: Common,
    description: "Enchant a tile into a gold tile. At then end of your turn, any gold tiles you occupy will generate 1 gold each."
)
