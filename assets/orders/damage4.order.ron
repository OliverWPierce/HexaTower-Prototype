ProxyOrder (
    name: "Battering Ram!",
    proxy_action: ProxyAction (
        functionality: ChangePieceHealth (
            change_method: Constant(20),
            is_heal: false,
        ),
        eligibility_method: Fan (width: Three, depth: 1, occupied_or_not: Occupied),
        selection_count_bounds: GameDesignBounds(Bounds(min_tiles: 1, max_tiles: 1)),
        ),
    description: "Attack any piece within a 3 wide 1 deep fan of this peice for 20 damage.",
    icon_path: "orders/icons/Magic Dagger.png"
)
