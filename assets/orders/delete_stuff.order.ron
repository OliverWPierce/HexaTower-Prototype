ProxyOrder (
    proxy_action: ProxyAction (
        functionality: DeleteTile,
        eligibility_method: UnoccupiedTiles,
        selection_count_bounds: GameDesignBounds(Bounds(min_tiles: 1, max_tiles: 5)),
        ),
    description: "This order deletes any tile you like.",
    icon_path: "orders/icons/sword.png"
)
